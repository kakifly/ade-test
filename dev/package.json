{
  "name": "habit-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts",
    "test": "bun test",
    "docs:basic-design": "bun scripts/src/generate-docs/gen-basic-design.ts",
    "docs:table-spec": "bun scripts/src/generate-docs/gen-table-spec.ts",
    "docs:requirements": "bun scripts/src/generate-docs/build-requirements-docx.js",
    "docs:build": "pnpm run docs:table-spec && pnpm run docs:basic-design && pnpm run docs:requirements",
    "test:unit": "bun test --path-ignore-patterns '**/*.int.test.ts'",
    "test:int": "bun test '.int.test.ts'",
    "db:apply": "bash scripts/src/db-apply.sh",
    "db:apply:test": "bash scripts/src/db-apply.sh test",
    "verify": "pnpm run typecheck && pnpm run db:apply:test && bun test",
    "prepare": "cd .. && husky",
    "e2e": "bash scripts/src/e2e/run.sh",
    "db:apply:e2e": "bash scripts/src/db-apply.sh e2e",
    "start:api": "pnpm --filter @habit/api start",
    "build:web": "pnpm --filter @habit/web build",
    "start:web": "pnpm --filter @habit/web start"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "docx": "^9.15.1",
    "exceljs": "^4.4.0",
    "husky": "^9.1.7",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.6.1"
}
