{
  "name": "@habit/web",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build:css": "tailwindcss -i ./tokens.css -o ./app.css",
    "build": "pnpm run build:css && bun build ./index.html --outdir ./dist",
    "start": "bun --env-file=../api/.env serve.ts"
  },
  "dependencies": {
    "@habit/core": "workspace:*",
    "@habit/zod": "workspace:*",
    "@hookform/resolvers": "^7.0.1",
    "@tanstack/react-table": "^8.21.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.4"
  }
}
