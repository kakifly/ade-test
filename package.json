{
  "name": "habit-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "dev/packages/src/*",
    "dev/apps/src/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p dev/scripts",
    "test": "bun test",
    "docs:basic-design": "bun dev/scripts/src/generate-docs/gen-basic-design.ts",
    "docs:table-spec": "bun dev/scripts/src/generate-docs/gen-table-spec.ts",
    "docs:requirements": "bun dev/scripts/src/generate-docs/build-requirements-docx.js",
    "docs:build": "bun run docs:table-spec && bun run docs:basic-design && bun run docs:requirements",
    "test:unit": "bun test --path-ignore-patterns '**/*.int.test.ts'",
    "test:int": "bun test '.int.test.ts'",
    "db:apply": "bash dev/scripts/src/db-apply.sh",
    "db:apply:test": "bash dev/scripts/src/db-apply.sh test",
    "verify": "bun run typecheck && bun run db:apply:test && bun test",
    "prepare": "husky",
    "e2e": "node dev/scripts/src/e2e/accept.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "docx": "^9.15.1",
    "exceljs": "^4.4.0",
    "husky": "^9.1.7",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
