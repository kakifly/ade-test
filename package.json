{
  "name": "habit-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "dev/packages/src/*",
    "dev/apps/src/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p dev/scripts",
    "test": "bun test",
    "docs:basic-design": "bun dev/scripts/src/generate-docs/gen-basic-design.ts",
    "test:unit": "bun test --path-ignore-patterns '**/*.int.test.ts'",
    "test:int": "bun test '.int.test.ts'",
    "db:apply": "bash dev/scripts/src/db-apply.sh",
    "db:apply:test": "bash dev/scripts/src/db-apply.sh test",
    "verify": "bun run typecheck && bun run db:apply:test && bun test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "exceljs": "^4.4.0",
    "typescript": "^7.0.2"
  }
}
